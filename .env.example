# Uptime Kuma client configuration for kumactl
# Source this file or export the variables before running kumactl / kumactl-mcp.
# Env vars stay UPTIME_KUMA_*; wrapper prefers KUMACTL_ENV_FILE with KUMA_ENV_FILE fallback.
UPTIME_KUMA_URL=https://uptime.example.com
UPTIME_KUMA_USERNAME=your_username_here
UPTIME_KUMA_PASSWORD=your_password_here
